# Database Configuration
# On Railway these are injected automatically by the MySQL plugin.
# For local development, set them to match your local MySQL instance.
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=airbnb_clone
MYSQLUSER=root
MYSQLPASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Server Configuration
PORT=8080